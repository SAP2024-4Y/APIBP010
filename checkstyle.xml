<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle config for APIBP010.
  Philosophy: catch real problems (bad imports, missing braces, naming), skip
  purely cosmetic rules that vary by preference (magic numbers, method length).
  Line limit is 120 — generous enough for Spring annotations.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- ── File-level ──────────────────────────────────────────────────── -->

    <!-- No tabs in source — project uses 4-space indentation -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Max line length: 120 chars; imports and URLs are exempt -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package\s|^import\s|https?://|ftp://"/>
    </module>

    <!-- ── Tree-level (per Java file) ──────────────────────────────────── -->
    <module name="TreeWalker">

        <!-- Imports: no wildcards, no redundant, no unused -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Naming conventions (Java standard) -->
        <module name="TypeName"/>
        <module name="ConstantName"/>
        <module name="MemberName"/>
        <module name="StaticVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MethodName"/>
        <module name="PackageName"/>

        <!-- Braces: always required on if/else/for/while/do -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- Modifier order: public static final, not static public final -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Misc correctness -->
        <module name="UpperEll"/>        <!-- 1L not 1l — easy to misread -->
        <module name="ArrayTypeStyle"/>  <!-- String[] args, not String args[] -->

        <!-- Suppress Checkstyle on lines annotated with @SuppressWarnings("checkstyle:...") -->
        <module name="SuppressWarningsHolder"/>
    </module>

    <module name="SuppressWarningsFilter"/>
</module>
